# Development adapter only. Vercel must set FORMA_MODE=supabase.
FORMA_MODE=local
APP_ORIGIN=http://127.0.0.1:5173
# Optional public support address displayed in the help center.
SUPPORT_EMAIL=
PORT=8787
FORMA_DB_PATH=.data/forma.sqlite
OCR_LANG_PATH=.data/tessdata

# Required for Supabase mode; public values, but set on server for /api/config.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SERVER ONLY: required for billing; also enables cloud account deletion.
SUPABASE_SERVICE_ROLE_KEY=

# Optional paid analysis; both must be configured. Never prefix these with VITE_.
OPENAI_API_KEY=
# Select a model available to your account with image input + structured output.
OPENAI_VISION_MODEL=

# Payments stay closed until explicitly enabled. Start with a Paystack TEST key.
# Plan amount/currency/interval come from Paystack, never the browser.
FORMA_BILLING_ENABLED=false
PAYSTACK_SECRET_KEY=
PAYSTACK_PRO_PLAN_CODE=
# Configurable draft allowances, not published commercial pricing.
FORMA_FREE_ANALYSES_PER_MONTH=5
FORMA_PRO_ANALYSES_PER_MONTH=100

# Setup only: database connection string, never sent to the browser.
SUPABASE_DB_URL=

# Optional Gemini reference analysis, server only.
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.1-flash-lite

# Optional same-provider backup on temporary 5xx errors only.
GEMINI_FALLBACK_MODEL=gemini-3.8-flash

# Development-only escape from transient Gemini outages; requires OCR assets.
FORMA_LOCAL_ANALYSIS_FALLBACK=false
